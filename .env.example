# ========================================================================
# Facturador Self-Hosted Perú — variables de entorno
# ========================================================================
# Copiá este archivo a .env y completá lo OBLIGATORIO. Lo demás se puede
# configurar después desde la UI.
# ------------------------------------------------------------------------

# ========== OBLIGATORIO ==========

# Contraseñas de servicios internos. Generá unas largas y aleatorias.
POSTGRES_PASSWORD=cambiar_en_produccion

# Secreto JWT (firma de tokens de sesión). 32+ caracteres aleatorios.
# Generala con:  openssl rand -hex 32
API_JWT_SECRET=cambiar_a_un_secreto_largo_aleatorio_minimo_32_chars

# Llave maestra para cifrar credenciales SOL y passphrases de cert en DB.
# EXACTAMENTE 64 caracteres hex (= 32 bytes).
# Generala con:  openssl rand -hex 32
# Si la perdés, no podés descifrar los secretos guardados.
MASTER_KEY=cambiame_64_caracteres_hex_generados_con_openssl_rand_hex_32

# ========== EXPLORAR LA UI SIN CONFIGURAR NADA MÁS ==========
#
# Si solo querés ver cómo funciona el sistema:
#   1. Llená lo de arriba (3 secretos).
#   2. Levantá:  docker compose -f docker-compose.yml -f docker-compose.beta.yml up -d --build
#   3. Creá el primer usuario:
#         docker compose exec api /app/seed-user \
#             -email=tu@email -password=loquesea123 -nombre="Tu nombre" -rol=dueno
#      (sin TENANT_* en .env crea una empresa DEMO automáticamente)
#   4. Abrí http://localhost:5173, login, y arrancá a emitir.
#      Las emisiones se simulan, no llegan a SUNAT.
#
# Cuando quieras emitir de verdad: crear una empresa real desde "+ Nueva
# empresa", subir tu .p12 + passphrase y completar credenciales SOL en
# Configuración. Después destildá "Modo DEMO".

# ========== OPCIONAL — para auto-bootstrap de tenant inicial ==========
#
# Si querés que el primer arranque cree directamente tu empresa real con
# datos correctos (y migre cert.p12 legacy si lo tenías):
#
# TENANT_RUC=20000000001
# TENANT_RAZON_SOCIAL=MI EMPRESA SAC
# TENANT_NOMBRE_COMERCIAL=Mi Empresa
# TENANT_DIRECCION_FISCAL=AV. SIEMPRE VIVA 123
# TENANT_UBIGEO=150101
# TENANT_DEPARTAMENTO=LIMA
# TENANT_PROVINCIA=LIMA
# TENANT_DISTRITO=LIMA
# TENANT_USUARIO_SOL=MODDATOS
# TENANT_CLAVE_SOL=MODDATOS
# CERT_PATH=/app/certs/cert.p12
# CERT_PASSPHRASE=passphrase_de_tu_p12

# ========== INFRA — usualmente no se toca ==========

POSTGRES_USER=facturador
POSTGRES_DB=facturador
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

SUNAT_MODE=beta

API_PORT=8080
API_JWT_ACCESS_TTL=15m
API_JWT_REFRESH_TTL=720h
API_CORS_ORIGINS=http://localhost:5173

MOTOR_URL=http://motor:8000
MOTOR_PORT=8000

WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
