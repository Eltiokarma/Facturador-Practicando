# ========================================================================
# Facturador Self-Hosted Perú — variables de entorno
# ========================================================================
# Copiá este archivo a .env y completá lo que falta. NUNCA commitees el .env.
#
# Para emitir tu PRIMERA factura beta solo necesitás:
#   1) Bajar tu .p12 desde Clave SOL (Empresas → CDT) y dejarlo en ./certs/cert.p12
#   2) Crear un usuario secundario Clave SOL con permiso "Emisión de CPE"
#   3) Llenar las TENANT_* y CERT_PASSPHRASE de abajo
#   4) Levantar: docker compose -f docker-compose.yml -f docker-compose.beta.yml up -d
#   5) Correr: ./scripts/probar-factura.sh
# ------------------------------------------------------------------------

# "beta" (homologación) o "prod". Empezá SIEMPRE en beta.
SUNAT_MODE=beta

# ------------------------------------------------------------------------
# TENANT — tus datos de empresa
# ------------------------------------------------------------------------
# RUC de 11 dígitos
TENANT_RUC=20000000001
TENANT_RAZON_SOCIAL=MI EMPRESA DEMO SAC
TENANT_NOMBRE_COMERCIAL=MI EMPRESA
TENANT_DIRECCION_FISCAL=AV. SIEMPRE VIVA 123
TENANT_UBIGEO=150101
TENANT_DEPARTAMENTO=LIMA
TENANT_PROVINCIA=LIMA
TENANT_DISTRITO=LIMA

# ------------------------------------------------------------------------
# CREDENCIALES SUNAT — Clave SOL del usuario SECUNDARIO (NUNCA el principal)
# ------------------------------------------------------------------------
# Si todavía no creaste el usuario secundario, leé docs/crear-usuario-secundario.md.
# Para PRUEBAS contra el endpoint beta, SUNAT acepta el usuario clásico:
#   TENANT_USUARIO_SOL=MODDATOS
#   TENANT_CLAVE_SOL=MODDATOS
# pero el comprobante igual debe estar firmado con tu .p12 real.
TENANT_USUARIO_SOL=MODDATOS
TENANT_CLAVE_SOL=MODDATOS

# ------------------------------------------------------------------------
# CERTIFICADO DIGITAL TRIBUTARIO (.p12)
# ------------------------------------------------------------------------
# Path DENTRO del container. El compose monta ./certs:/app/certs:ro.
# Dejá tu archivo en ./certs/cert.p12 y todo funciona.
CERT_PATH=/app/certs/cert.p12
# La passphrase del .p12. SOLO en este archivo o en el shell — nunca en DB.
# Si reiniciás el container, hay que re-introducirla (es a propósito).
CERT_PASSPHRASE=cambiame

# ------------------------------------------------------------------------
# PostgreSQL (se usa en versiones posteriores; ya queda listo)
# ------------------------------------------------------------------------
POSTGRES_USER=facturador
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=facturador
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------
# Redis (cola asíncrona — usa en versiones posteriores)
# ------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------
# API Go
# ------------------------------------------------------------------------
API_PORT=8080
# Generá uno con:  openssl rand -hex 32
API_JWT_SECRET=cambiar_a_un_secreto_largo_aleatorio_minimo_32_chars
API_JWT_ACCESS_TTL=15m
API_JWT_REFRESH_TTL=720h
API_CORS_ORIGINS=http://localhost:5173

# URL interna del motor (red Docker — no tocar)
MOTOR_URL=http://motor:8000

# ------------------------------------------------------------------------
# Motor PHP / Greenter
# ------------------------------------------------------------------------
MOTOR_PORT=8000

# ------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
