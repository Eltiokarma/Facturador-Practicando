# ========================================================================
# Facturador Self-Hosted Perú — variables de entorno
# ========================================================================
# Copiá este archivo a .env y ajustá. NUNCA commitees el .env real.
# ------------------------------------------------------------------------

# Modo SUNAT global por defecto: "beta" (homologación) o "prod".
# Cada tenant puede sobrescribir esto en su configuración.
SUNAT_MODE=beta

# ------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------
POSTGRES_USER=facturador
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=facturador
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------
# Redis (cola de jobs hacia SUNAT)
# ------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------
# API Go
# ------------------------------------------------------------------------
API_PORT=8080
API_JWT_SECRET=cambiar_a_un_secreto_largo_aleatorio_minimo_32_chars
API_JWT_ACCESS_TTL=15m
API_JWT_REFRESH_TTL=720h

# Origen permitido del frontend (separados por coma si son varios)
API_CORS_ORIGINS=http://localhost:5173

# URL interna del motor (red privada Docker)
MOTOR_URL=http://motor:8000

# ------------------------------------------------------------------------
# Motor PHP / Greenter
# ------------------------------------------------------------------------
MOTOR_PORT=8000

# ------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
